# Copy to backend/.env and adjust. Never commit the real .env.

# development: a missing/placeholder JWT_SECRET is replaced by a random one at startup (with a warning)
# production:  the server refuses to start without a real JWT_SECRET
ENV=development
LOG_LEVEL=INFO

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=formfit

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Optional tuning (defaults shown)
# MODEL_PATH=ml/artifacts/form_model.joblib
# MAX_BODY_BYTES=1000000
# LOGIN_MAX_FAILURES=10
# LOGIN_WINDOW_SECONDS=900
# STALE_SESSION_HOURS=6
